{
  "name": "caption-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "latest",
    "playwright": "^1.65.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "8.3.0",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "scripts": {
    "dev": "XDG_CONFIG_HOME=.cache/xdg XDG_CACHE_HOME=.cache/xdg-cache vite dev",
    "build": "vite build",
    "start": "XDG_CONFIG_HOME=.cache/xdg XDG_CACHE_HOME=.cache/xdg-cache vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vinext-cloudflare deploy",
    "test": "vitest run"
  }
}
